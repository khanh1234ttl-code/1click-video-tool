{
  "author": {
    "name": "1 Click Studio",
    "url": "https://1clickvn.com/workshop/"
  },
  "name": "Vids Automation - 1 Click Studio",
  "description": "Auto VEO & Voice your prompts at scale. Batch generate and auto-download videos and images on docs.google.com/videos.",
  "version": "1.1.10.0",
  "version_name": "1.1.10.0 - bridge cho 1Click Video Tool",
  "manifest_version": 3,
  "action": {
    "default_title": "Vids Automation - 1 Click Studio",
    "default_icon": {
      "16": "src/assets/logo.png",
      "24": "src/assets/logo.png",
      "32": "src/assets/logo.png",
      "128": "src/assets/logo.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-CipPswBN.js"
      ],
      "all_frames": false,
      "matches": [
        "*://docs.google.com/videos/*"
      ],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "src/ui/side-panel/index.html"
  },
  "offline_enabled": true,
  "host_permissions": [
    "*://docs.google.com/videos/*",
    "http://127.0.0.1/*"
  ],
  "permissions": [
    "storage",
    "tabs",
    "background",
    "sidePanel",
    "activeTab",
    "downloads",
    "debugger",
    "scripting",
    "alarms"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://docs.google.com/*"
      ],
      "resources": [
        "assets/workflowResults-qoMMSAXH.js",
        "assets/catchUploadFile.ts-DSScj7vH.js",
        "assets/index.ts-DUXzPPUe.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "src/assets/logo.png",
    "24": "src/assets/logo.png",
    "32": "src/assets/logo.png",
    "128": "src/assets/logo.png"
  },
  "homepage_url": "https://1clickvn.com/workshop/"
}
