{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "1Click Video Tool",
  "version": "0.1.0",
  "identifier": "vn.1clickstudio.videotool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "1Click Video Tool", "width": 1280, "height": 820, "minWidth": 1000, "minHeight": 640 }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
